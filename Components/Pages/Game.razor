@page "/game"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IHostEnvironment HostEnvironment
@inject MSPChallenge_Client_Browser.Services.SessionState SessionState
@inject MSPChallenge_Client_Browser.Services.MspApiClient ApiClient
@inject MSPChallenge_Client_Browser.Services.GameWebSocketService WsService
@inject MSPChallenge_Client_Browser.Services.GameSessionState GameState

<PageTitle>MSP Challenge – Game</PageTitle>

<div id="map" class="map-viewport"></div>

@* Right-side column: game-bar always on top, panels below *@
@if (!_isLoading && !_loadingFading)
{
    var _barStartYear = _gameStartYear;
    var _barEndYear   = _gameEndYear > 0 ? _gameEndYear : _gameStartYear + 30;
    var _totalMonths  = _gameEndMonth > 0 ? _gameEndMonth
                      : _gameEndYear > 0  ? (_gameEndYear - _gameStartYear) * 12
                      : 0;
    var _barProgress  = _totalMonths > 0
        ? Math.Clamp((double)_gameCurrentMonth / _totalMonths * 100.0, 0, 100)
        : 0;
    var _barDate      = new DateTime(_gameStartYear, 1, 1).AddMonths(_gameCurrentMonth).ToString("MMMM yyyy");
    <div class="map-right-panels">
        <div class="game-bar">
            <div class="game-bar-row">
                <div class="game-bar-clock">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12,6 12,12 16,14"/>
                    </svg>
                </div>
                <div class="game-bar-body">
                    <div class="game-bar-date">@_barDate</div>
                    <div class="game-bar-timeline">
                        <span class="game-bar-year">@_barStartYear</span>
                        <div class="game-bar-track">
                            <div class="game-bar-fill" style="width:@(_barProgress.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            <div class="game-bar-needle" style="left:@(_barProgress.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            @if (_selectedPlanId != 0)
                            {
                                var _planForNeedle = _plans.FirstOrDefault(p => p.PlanId == _selectedPlanId);
                                var _planTotalMonths = _gameEndMonth > 0 ? _gameEndMonth
                                    : _gameEndYear > 0 ? (_gameEndYear - _gameStartYear) * 12 : 0;
                                if (_planForNeedle is not null && _planTotalMonths > 0)
                                {
                                    var _planNeedlePct = Math.Clamp((double)_planForNeedle.StartDate / _planTotalMonths * 100.0, 0, 100);
                                    <div class="game-bar-plan-needle" style="left:@(_planNeedlePct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%"
                                         title="Plan time: @MonthToDate(_planForNeedle.StartDate)"></div>
                                }
                            }
                        </div>
                        <span class="game-bar-year">@_barEndYear</span>
                    </div>
                </div>
                <div class="game-bar-state">
                    <div class="game-bar-state-label">@GameStateLabel</div>
                    <div class="game-bar-timeleft">@FormatTimeLeft(_eraTimeLeft)</div>
                </div>
            </div>
            @if (_selectedPlanId != 0)
            {
                var _viewPlan = _plans.FirstOrDefault(p => p.PlanId == _selectedPlanId);
                if (_viewPlan is not null)
                {
                    <div class="game-bar-plan-view">
                        <div class="game-bar-plan-time">
                            <svg class="game-bar-plan-eye" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" xmlns="http://www.w3.org/2000/svg">
                                <ellipse cx="10" cy="10" rx="8" ry="5"/>
                                <circle cx="10" cy="10" r="2.5" fill="currentColor" stroke="none"/>
                            </svg>
                            <span class="game-bar-plan-time-label">Viewing plan</span>
                            <span class="game-bar-plan-time-date">@MonthToDate(_viewPlan.StartDate)</span>
                        </div>
                        <div class="game-bar-plan-modes">
                            <button class="plan-mode-btn @(_planViewMode == PlanViewMode.Original ? "plan-mode-btn--active" : "")"
                                    title="Show original data only"
                                    @onclick="@(async () => await SetPlanViewModeAsync(PlanViewMode.Original))">
                                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M4 2h8l4 4v12H4V2z"/>
                                    <path d="M12 2v4h4"/>
                                    <line x1="7" y1="9"  x2="13" y2="9"  stroke-width="1.1"/>
                                    <line x1="7" y1="12" x2="13" y2="12" stroke-width="1.1"/>
                                    <line x1="7" y1="15" x2="11" y2="15" stroke-width="1.1"/>
                                </svg>
                                <span>Original</span>
                            </button>
                            <button class="plan-mode-btn @(_planViewMode == PlanViewMode.AfterChanges ? "plan-mode-btn--active" : "")"
                                    title="Show base data with plan changes applied"
                                    @onclick="@(async () => await SetPlanViewModeAsync(PlanViewMode.AfterChanges))">
                                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M4 2h8l4 4v12H4V2z" opacity="0.65"/>
                                    <path d="M12 2v4h4" opacity="0.65"/>
                                    <line x1="7" y1="9"  x2="11" y2="9"  stroke-width="1.1" opacity="0.65"/>
                                    <line x1="7" y1="12" x2="11" y2="12" stroke-width="1.1" opacity="0.65"/>
                                    <path d="M12 2L16 6H12V2z" fill="currentColor" fill-opacity="0.75" stroke="currentColor" stroke-width="1.3"/>
                                </svg>
                                <span>After changes</span>
                            </button>
                            <button class="plan-mode-btn @(_planViewMode == PlanViewMode.ChangesOnly ? "plan-mode-btn--active" : "")"
                                    title="Show plan changes only, without base data"
                                    @onclick="@(async () => await SetPlanViewModeAsync(PlanViewMode.ChangesOnly))">
                                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M4 2h8l4 4v12H4V2z" opacity="0.22" stroke-dasharray="3,2"/>
                                    <path d="M12 2v4h4" opacity="0.22"/>
                                    <path d="M12 2L16 6H12V2z" fill="currentColor" fill-opacity="0.75" stroke="currentColor" stroke-width="1.4"/>
                                </svg>
                                <span>Changes only</span>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
<nav class="map-sidebar">
    <button class="sidebar-btn" title="Home"
            @onclick="@(() => NavigationManager.NavigateTo("/"))">
        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 1L1 7h2v7h4v-4h2v4h4V7h2L8 1z"/>
        </svg>
    </button>
    <div class="sidebar-separator"></div>
    @{
        var _myColour = _countryColours.GetValueOrDefault(SessionState.CountryId, "");
        var _usersBtnStyle = CountryBtnStyle(_myColour, _usersPanelOpen);
    }
    <button class="sidebar-btn" style="@_usersBtnStyle"
            title="Online users"
            @onclick="ToggleUsersPanelAsync">
        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <circle cx="5.5" cy="4.5" r="2.5"/>
            <path d="M0.5 13.5c0-2.76 2.24-5 5-5s5 2.24 5 5"/>
            <circle cx="11.5" cy="4.5" r="2" opacity="0.55"/>
            <path d="M10.5 13.5a5 5 0 0 1 1-3.06A4.5 4.5 0 0 1 15.5 13.5" opacity="0.55"/>
        </svg>
    </button>
    <div class="sidebar-separator"></div>
    <button class="sidebar-btn @(_plansPanelOpen ? "sidebar-btn--active" : "")" title="Plans"
            @onclick="TogglePlansPanel">
        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 2h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.3"/>
            <line x1="4.5" y1="5.5" x2="11.5" y2="5.5" stroke="currentColor" stroke-width="1.2"/>
            <line x1="4.5" y1="8"   x2="11.5" y2="8"   stroke="currentColor" stroke-width="1.2"/>
            <line x1="4.5" y1="10.5" x2="9"   y2="10.5" stroke="currentColor" stroke-width="1.2"/>
        </svg>
    </button>
    <div class="sidebar-separator"></div>
    @if (GameState.DependencyGroups.Count > 0)
    {
        <button class="sidebar-btn" title="Dependencies"
                @onclick="@(() => NavigationManager.NavigateTo("/game/dependencies"))">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" xmlns="http://www.w3.org/2000/svg">
                <circle cx="8" cy="8" r="6"/>
                <path d="M8 2 Q8 8 14 8"  stroke-width="1.0" opacity="0.85"/>
                <path d="M8 2 Q8 8 4 13"  stroke-width="1.0" opacity="0.85"/>
                <path d="M14 8 Q8 8 4 13" stroke-width="1.0" opacity="0.85"/>
            </svg>
        </button>
        <div class="sidebar-separator"></div>
    }
    <button class="sidebar-btn @(_layerPanelOpen ? "sidebar-btn--active" : "")"
            title="Layers"
            @onclick="ToggleLayerPanel">
        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 1l7 3.5-7 3.5L1 4.5 8 1z"/>
            <path d="M1 8.5l7 3.5 7-3.5"/>
            <path d="M1 12l7 3.5L15 12"/>
        </svg>
    </button>
    <button class="sidebar-btn @(_legendPanelOpen ? "sidebar-btn--active" : "")" title="Legend"
            @onclick="ToggleLegendPanel">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="3" width="4" height="4" rx="0.5" fill="currentColor" stroke="none" opacity="0.7"/>
            <line x1="8" y1="5" x2="14" y2="5"/>
            <rect x="2" y="9" width="4" height="4" rx="0.5" fill="currentColor" stroke="none" opacity="0.7"/>
            <line x1="8" y1="11" x2="14" y2="11"/>
        </svg>
    </button>
</nav>

@* Floating panels attached to the sidebar *@

        @* Plan detail panel — shown when a plan is selected *@
        @if (_selectedPlanId != 0)
        {
            var _detailPlan = _plans.FirstOrDefault(p => p.PlanId == _selectedPlanId);
            if (_detailPlan is not null)
            {
                var _detailLayers = _detailPlan.Layers
                    .Select(l => _layerEntries.FirstOrDefault(e => e.LayerId == l.OriginalLayerId)?.DisplayName)
                    .OfType<string>()
                    .Distinct()
                    .ToList();
                var _detailDotColour = (_detailPlan.Country == 1 || _detailPlan.Country == 2)
                    ? "#ff69b4"
                    : _countryColours.GetValueOrDefault(_detailPlan.Country, "#6c757d");
                var _detailCountryName = _countryNames.GetValueOrDefault(_detailPlan.Country, $"Country {_detailPlan.Country}");
                <div class="plan-detail-panel">
                    <div class="plan-detail-header">
                        <span class="user-dot" style="background:@_detailDotColour;flex-shrink:0" title="@_detailCountryName"></span>
                        <div class="plan-detail-header-body">
                            <span class="plan-detail-title">@_detailPlan.Name</span>
                            @if (!string.IsNullOrWhiteSpace(_detailPlan.Description))
                            {
                                <div class="plan-detail-desc">
                                    <span class="plan-detail-desc-text @(_detailDescExpanded ? "plan-detail-desc-text--expanded" : "")">@_detailPlan.Description</span>
                                    @if (_detailPlan.Description.Length > 40)
                                    {
                                        <button class="plan-detail-desc-btn" title="@(_detailDescExpanded ? "Show less" : "Show full description")" @onclick="@(() => _detailDescExpanded = !_detailDescExpanded)">
                                            @if (_detailDescExpanded)
                                            {
                                                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" xmlns="http://www.w3.org/2000/svg"><polyline points="2,8 6,4 10,8"/></svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" xmlns="http://www.w3.org/2000/svg"><polyline points="2,4 6,8 10,4"/></svg>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <button class="panel-close-btn" title="Close"
                                @onclick="@(async () => await ClosePlanDetailAsync())">&#10005;</button>
                    </div>
                    <details class="plan-detail-section plan-detail-section--state" open>
                        <summary class="plan-detail-section-hdr">Plan Info</summary>
                        <div class="plan-detail-section-body">
                            <div class="plan-detail-info-row">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon">
                                    <circle cx="8" cy="8" r="6.5"/>
                                    <polyline points="8,4.5 8,8 10.5,9.5"/>
                                </svg>
                                <span>@MonthToDate(_detailPlan.StartDate)@(_detailPlan.ConstructionTime > 0 ? $", after {_detailPlan.ConstructionTime} months construction" : "")</span>
                            </div>
                            @{
                                bool isManager = SessionState.CountryId <= 2;
                                var canChangeState = !_detailPlan.State.Equals("IMPLEMENTED", StringComparison.OrdinalIgnoreCase)
                                    && (isManager || _detailPlan.Country == SessionState.CountryId);
                            }
                            <div class="plan-detail-state-row">
                                @if (_planStateOpen)
                                {
                                    <div class="plan-message-panel plan-state-panel">
                                        <div class="plan-message-panel-header">
                                            <span class="plan-message-panel-title">Plan State</span>
                                            <button class="panel-close-btn" type="button" title="Close" @onclick="TogglePlanStatePanel">&#10005;</button>
                                        </div>
                                        <div class="plan-message-panel-body plan-state-panel-body">
                                            @{
                                                var availableStates = GetAvailablePlanStates(_detailPlan);
                                            }
                                            <div class="plan-state-dropdown @(_planStateDropdownOpen ? "open" : "")">
                                                <button class="plan-state-dropdown-trigger" type="button"
                                                        disabled="@_planStateSending"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="@(() => _planStateDropdownOpen = !_planStateDropdownOpen)">
                                                    <span>@PlanStateLabel(_planStatePending)</span>
                                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg" class="plan-state-dropdown-arrow">
                                                        <polyline points="4,6 8,10 12,6"/>
                                                    </svg>
                                                </button>
                                                @if (_planStateDropdownOpen)
                                                {
                                                    <div class="plan-state-dropdown-list">
                                                        @foreach (var s in availableStates)
                                                        {
                                                            var sLocal = s;
                                                            <button class="plan-state-dropdown-item @(sLocal == _planStatePending ? "selected" : "")"
                                                                    type="button"
                                                                    @onclick:stopPropagation="true"
                                                                    @onclick="@(() => { _planStatePending = sLocal; _planStateDropdownOpen = false; })">
                                                                @PlanStateLabel(sLocal)
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <div class="plan-state-actions">
                                                <button class="plan-state-btn plan-state-btn--cancel" type="button"
                                                        title="Cancel" disabled="@_planStateSending"
                                                        @onclick="TogglePlanStatePanel">
                                                    &#10005;
                                                </button>
                                                <button class="plan-state-btn plan-state-btn--confirm" type="button"
                                                        title="Confirm" disabled="@_planStateSending"
                                                        @onclick="SetPlanStateAsync">
                                                    &#10003;
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (canChangeState)
                                {
                                    <button class="plan-detail-action-row" type="button" @onclick="TogglePlanStatePanel">
                                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon">
                                            <path d="M2 4h12v8a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V4z"/>
                                            <path d="M2 4l6-2 6 2"/>
                                        </svg>
                                        <span>Plan state: @PlanStateLabel(_detailPlan.State)</span>
                                    </button>
                                }
                                else
                                {
                                    <div class="plan-detail-info-row">
                                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon">
                                            <path d="M2 4h12v8a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V4z"/>
                                            <path d="M2 4l6-2 6 2"/>
                                        </svg>
                                        <span>Plan state: @PlanStateLabel(_detailPlan.State)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </details>
                    <details class="plan-detail-section plan-detail-section--communication" open>
                        <summary class="plan-detail-section-hdr">Communication</summary>
                        <div class="plan-detail-section-body">
                            @if (!IsApprovalCompleteState(SelectedPlanState))
                            {
                            <div class="plan-detail-approval-row">
                                @if (_planApprovalOpen)
                                {
                                    <div class="plan-message-panel plan-approval-panel">
                                        <div class="plan-message-panel-header">
                                            <span class="plan-message-panel-title">Approval</span>
                                            <button class="panel-close-btn" type="button" title="Close" @onclick="ToggleApprovalPanel">&#10005;</button>
                                        </div>
                                        <div class="plan-message-panel-body">
                                            @if (_approvalRequired.Count == 0)
                                            {
                                                <div class="plan-message-empty">No approval required for this plan.</div>
                                            }
                                            else
                                            {
                                                var approvalPlan = _plans.FirstOrDefault(p => p.PlanId == _selectedPlanId);
                                                var isVotingState = approvalPlan?.State.Equals("APPROVAL", StringComparison.OrdinalIgnoreCase) == true;
                                                var myCountryId   = SessionState.CountryId;
                                                <table class="plan-approval-table">
                                                    <thead>
                                                        <tr>
                                                            <th class="plan-approval-th plan-approval-th--name"></th>
                                                            <th class="plan-approval-th">No</th>
                                                            <th class="plan-approval-th">?</th>
                                                            <th class="plan-approval-th">Yes</th>
                                                            <th class="plan-approval-th">Why</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var req in _approvalRequired)
                                                        {
                                                            var dotCol     = _countryColours.GetValueOrDefault(req.CountryId, "#6c757d");
                                                            var currentVote = approvalPlan?.Votes?.TryGetValue(req.CountryId, out var v) == true ? v : -1;
                                                            var isMyRow    = isVotingState && req.CountryId == myCountryId;
                                                            <tr class="plan-approval-row">
                                                                <td class="plan-approval-td plan-approval-td--name">@req.CountryName</td>

                                                                @* No column *@
                                                                <td class="plan-approval-td plan-approval-td--vote">
                                                                    @if (isMyRow)
                                                                    {
                                                                        <button class="plan-approval-vote-btn @(currentVote == 0 ? "plan-approval-vote-btn--active" : "")"
                                                                                style="@(currentVote == 0 ? $"background:{dotCol};border-color:{dotCol}" : "")"
                                                                                disabled="@_sendingVote"
                                                                                title="Disapprove"
                                                                                type="button"
                                                                                @onclick="@(() => VoteOnPlanAsync(_selectedPlanId, currentVote == 0 ? -1 : 0))">
                                                                        </button>
                                                                    }
                                                                    else if (isVotingState && currentVote == 0)
                                                                    {
                                                                        <span class="user-dot" style="background:@dotCol" title="@req.CountryName: Disapproved"></span>
                                                                    }
                                                                </td>

                                                                @* ? column *@
                                                                <td class="plan-approval-td plan-approval-td--vote">
                                                                    @if (!isVotingState || currentVote == -1)
                                                                    {
                                                                        <span class="user-dot" style="background:@dotCol" title="@req.CountryName"></span>
                                                                    }
                                                                </td>

                                                                @* Yes column *@
                                                                <td class="plan-approval-td plan-approval-td--vote">
                                                                    @if (isMyRow)
                                                                    {
                                                                        <button class="plan-approval-vote-btn @(currentVote == 1 ? "plan-approval-vote-btn--active" : "")"
                                                                                style="@(currentVote == 1 ? $"background:{dotCol};border-color:{dotCol}" : "")"
                                                                                disabled="@_sendingVote"
                                                                                title="Approve"
                                                                                type="button"
                                                                                @onclick="@(() => VoteOnPlanAsync(_selectedPlanId, currentVote == 1 ? -1 : 1))">
                                                                        </button>
                                                                    }
                                                                    else if (isVotingState && currentVote == 1)
                                                                    {
                                                                        <span class="user-dot" style="background:@dotCol" title="@req.CountryName: Approved"></span>
                                                                    }
                                                                </td>

                                                                <td class="plan-approval-td plan-approval-td--vote">
                                                                    @if (req.Reasons.Count > 0)
                                                                    {
                                                                        <button class="plan-approval-why-btn" type="button"
                                                                                title="Why does @req.CountryName need to approve?"
                                                                                @onclick="@(() => ToggleApprovalReasonExpanded(req.CountryId))">
                                                                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"
                                                                                 xmlns="http://www.w3.org/2000/svg">
                                                                                <circle cx="8" cy="8" r="6.5"/>
                                                                                <line x1="8" y1="6" x2="8" y2="8.5"/>
                                                                                <circle cx="8" cy="10.5" r="0.7" fill="currentColor" stroke="none"/>
                                                                            </svg>
                                                                        </button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                            @if (_approvalReasonsExpanded.Contains(req.CountryId))
                                                            {
                                                                <tr class="plan-approval-reasons-row">
                                                                    <td colspan="5">
                                                                        <ul class="plan-approval-reasons">
                                                                            @foreach (var reason in req.Reasons)
                                                                            {
                                                                                <li>@reason</li>
                                                                            }
                                                                        </ul>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </div>
                                    </div>
                                }
                                <button class="plan-detail-action-row" @onclick="ToggleApprovalPanel">
                                    @if (_approvalRequired.Count > 0)
                                    {
                                        <svg viewBox="0 0 16 16" fill="none" stroke="#74c0fc" stroke-width="1.7" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon" style="color:#74c0fc">
                                            <polyline points="2.5,8 6,11.5 13.5,4.5"/>
                                        </svg>
                                        <span>Requires approval from @_approvalRequired.Count team@(_approvalRequired.Count == 1 ? "" : "s")</span>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon">
                                            <line x1="4" y1="4" x2="12" y2="12"/>
                                            <line x1="12" y1="4" x2="4" y2="12"/>
                                        </svg>
                                        <span>No approval required</span>
                                    }
                                </button>
                            </div>
                            }
                            <div class="plan-detail-chat-row">
                                @if (_planMessagesOpen)
                                {
                                    <div class="plan-message-panel">
                                        <div class="plan-message-panel-header">
                                            <span class="plan-message-panel-title">Communication</span>
                                            <button class="panel-close-btn" type="button" title="Close" @onclick="TogglePlanMessagesPanel">&#10005;</button>
                                        </div>
                                        <div class="plan-message-panel-body">
                                            @if (SelectedPlanMessages.Count == 0)
                                            {
                                                <div class="plan-message-empty">No messages yet.</div>
                                            }
                                            else
                                            {
                                                @foreach (var message in SelectedPlanMessages)
                                                {
                                                    var isOwnTeam = message.CountryId.HasValue && message.CountryId.Value == SessionState.CountryId;
                                                    var messageDotColour = PlanMessageDotColour(message.CountryId);
                                                    <div class="plan-message-row @(isOwnTeam ? "plan-message-row--own" : "plan-message-row--other")">
                                                        <div class="plan-message-bubble">
                                                            <div class="plan-message-meta">
                                                                <span class="user-dot plan-message-dot" style="background:@messageDotColour" title="@message.CountryName"></span>
                                                                <span class="plan-message-sender">@(!string.IsNullOrWhiteSpace(message.UserName) ? message.UserName : message.CountryName)</span>
                                                                @if (message.SentAt is not null)
                                                                {
                                                                    <span class="plan-message-time">@FormatPlanMessageTime(message.SentAt.Value)</span>
                                                                }
                                                            </div>
                                                            <div class="plan-message-text">@message.Message</div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <div class="plan-message-panel-composer">
                                            <input class="plan-message-input app-input"
                                                   type="text"
                                                   placeholder="Write message..."
                                                   @bind="_planMessageDraft"
                                                   @bind:event="oninput"
                                                  @onkeydown="HandlePlanMessageKeyDown"
                                                   disabled="@_sendingPlanMessage" />
                                            <button class="plan-message-send"
                                                    type="button"
                                                    @onclick="SendPlanMessageAsync"
                                                    disabled="@(!CanSendPlanMessage)">Send</button>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(_planMessageSendError))
                                        {
                                            <div class="plan-message-send-error">@_planMessageSendError</div>
                                        }
                                    </div>
                                }
                                <button class="plan-detail-action-row" @onclick="TogglePlanMessagesPanel">
                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon">
                                        <path d="M2 3h12a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H5l-3 2V4a1 1 0 0 1 1-1z"/>
                                    </svg>
                                    <span>See @_detailPlan.MessageCount message@(_detailPlan.MessageCount == 1 ? "" : "s")</span>
                                </button>
                            </div>
                            <div class="plan-detail-issues-row">
                                @if (_planIssuesOpen)
                                {
                                    <div class="plan-message-panel plan-issues-panel">
                                        <div class="plan-message-panel-header">
                                            <span class="plan-message-panel-title">Issues</span>
                                            <button class="panel-close-btn" type="button" title="Close" @onclick="TogglePlanIssuesPanel">&#10005;</button>
                                        </div>
                                        <div class="plan-message-panel-body">
                                            @if (SelectedPlanIssues.Count == 0)
                                            {
                                                <div class="plan-message-empty">No issues found for this plan geometry.</div>
                                            }
                                            else
                                            {
                                                @foreach (var issue in SelectedPlanIssues)
                                                {
                                                    var severityClass = issue.Severity.ToLowerInvariant();
                                                    <div class="plan-message-row plan-message-row--other">
                                                        <button class="plan-message-bubble plan-issue-bubble plan-issue-entry"
                                                                type="button"
                                                                title="Focus issue on map"
                                                                @onclick="@(async () => await FocusPlanIssueAsync(issue))">
                                                            <div class="plan-message-meta">
                                                                <span class="plan-issue-severity plan-issue-severity--@severityClass">@issue.Severity</span>
                                                                <span class="plan-message-time">@issue.ChangeKind</span>
                                                            </div>
                                                            <div class="plan-message-text">@issue.Message</div>
                                                            <div class="plan-issue-layers">@issue.SourceLayer &lt;-&gt; @issue.TargetLayer</div>
                                                        </button>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                                <button class="plan-detail-action-row" @onclick="TogglePlanIssuesPanel">
                                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon">
                                        <path d="M8 2L1.5 13.5h13L8 2z"/>
                                        <line x1="8" y1="6.5" x2="8" y2="9.5"/>
                                        <circle cx="8" cy="11.5" r="0.6" fill="currentColor"/>
                                    </svg>
                                    @if (SelectedPlanIssueCount == 0)
                                    {
                                        <span>No issues</span>
                                    }
                                    else
                                    {
                                        <span>@SelectedPlanIssueCount issue@(SelectedPlanIssueCount == 1 ? "" : "s")</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </details>
                    @if (_detailPlan.PolicyNames.Count > 0)
                    {
                        <details class="plan-detail-section" open>
                            <summary class="plan-detail-section-hdr">Policies</summary>
                            <div class="plan-detail-section-body">
                                @foreach (var pname in _detailPlan.PolicyNames)
                                {
                                    <div class="plan-detail-item-row">
                                        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon">
                                            <path d="M8 1l1.5 3.5H13l-2.8 2 1 3.5L8 8l-3.2 2 1-3.5L3 5h3.5L8 1z"/>
                                        </svg>
                                        <span>@pname</span>
                                    </div>
                                }
                            </div>
                        </details>
                    }
                    @if (_detailLayers.Count > 0)
                    {
                        <details class="plan-detail-section" open>
                            <summary class="plan-detail-section-hdr">Data Layers</summary>
                            <div class="plan-detail-section-body">
                                @foreach (var lname in _detailLayers)
                                {
                                    <div class="plan-detail-item-row">
                                        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon" opacity="0.8">
                                            <path d="M8 1l7 3.5-7 3.5L1 4.5 8 1z"/>
                                            <path d="M1 8.5l7 3.5 7-3.5" fill="none" stroke="currentColor" stroke-width="1.3"/>
                                        </svg>
                                        <span>@lname</span>
                                    </div>
                                }
                            </div>
                        </details>
                    }
                    <button class="plan-edit-btn">Enter Edit Mode</button>
                </div>
            }
        }

    </div>
}

@* Plans panel — free-floating, draggable, centred on first open *@
@if (!_isLoading && !_loadingFading && _plansPanelOpen)
{
    <div class="plans-panel" id="plans-panel-float">
    <div class="plans-panel-header plans-panel-drag-handle">
        <span class="plans-panel-title">Plans</span>
        <button class="panel-close-btn" title="Close" @onclick="@(() => SetPlansPanelOpen(false))">&#10005;</button>
    </div>
    <div class="plans-panel-content">
    @{
        bool _isPrivileged = SessionState.CountryId == 1 || SessionState.CountryId == 2;
        var _visiblePlans = _plans
            .Where(p => _isPrivileged || p.StartDate != -1)
            .Where(p => _isPrivileged || p.State.ToUpperInvariant() != "DESIGN" || p.Country == SessionState.CountryId)
            .GroupBy(p => p.State.ToUpperInvariant())
            .ToDictionary(g => g.Key, g => g.ToList());
    }
    @if (!_isPrivileged && _plans.Count == 0)
    {
        <div class="plans-status">Waiting for game data…</div>
    }
    @foreach (var state in GameSessionState.OrderedPlanStates)
    {
        var _statePlans = _visiblePlans.GetValueOrDefault(state, []);
        <details class="plan-group" open>
            <summary class="plan-group-header">
                @PlanStateLabel(state)
                <span class="plan-group-count">@_statePlans.Count</span>
            </summary>
            @if (_statePlans.Count == 0)
            {
                <div class="plans-empty-state">No plans in this state</div>
            }
            else
            {
                @foreach (var plan in _statePlans)
                {
                    var _planDotColour = (plan.Country == 1 || plan.Country == 2)
                        ? "#ff69b4"
                        : _countryColours.GetValueOrDefault(plan.Country, "#6c757d");
                    <div class="plan-row @(_selectedPlanId == plan.PlanId ? "plan-row--selected" : "")"
                         @onclick="@(() => SelectPlanAsync(plan))">
                        <span class="user-dot" style="background:@_planDotColour;" title="@(_countryNames.GetValueOrDefault(plan.Country, $"Country {plan.Country}"))"></span>
                        <span class="plan-name">@plan.Name</span>
                        @if (_planIssueSeverity.TryGetValue(plan.PlanId, out var _planBadgeSev))
                        {
                            <span class="plan-issue-badge plan-issue-badge--@_planBadgeSev.ToLowerInvariant()"
                                  title="Has @_planBadgeSev.ToLowerInvariant() issues">
                                <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="plan-issue-badge-icon">
                                    <path d="M8 1.5L1 14h14L8 1.5zm0 2.2l5.5 9.3H2.5L8 3.7zM7.25 7v3.5h1.5V7H7.25zm0 4.5v1.5h1.5v-1.5H7.25z"/>
                                </svg>
                            </span>
                        }
                        <span class="plan-date">@MonthToDate(plan.StartDate)</span>
                    </div>
                }
            }
        </details>
    }
    </div>
    </div>
}

@* Left-side layer + legend panels *@
<div class="map-sidebar-panels">
    @if (_usersPanelOpen)
    {
        <div class="users-panel">
            <div class="users-panel-header">
                <span class="users-panel-title">Online Users</span>
                <button class="users-refresh-btn" title="Refresh" @onclick="LoadUsersAsync" disabled="@_usersLoading">
                    <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path d="M13.65 2.35A8 8 0 1 0 15 8h-1.5a6.5 6.5 0 1 1-1.17-3.73L10 7h5V2l-1.35 0.35z"/>
                    </svg>
                </button>
                <button class="panel-close-btn" title="Close" @onclick="@(() => SetUsersPanelOpenAsync(false))">&#10005;</button>
            </div>
            <div class="users-panel-content">
            @{
                var _myCountryColour = _countryColours.GetValueOrDefault(SessionState.CountryId, "#6c757d");
            }
            <div class="users-my-country">
                <span class="user-dot" style="background:@_myCountryColour;"></span>
                <span>Your country:&nbsp;<strong>@(_countryNames.GetValueOrDefault(SessionState.CountryId, $"#{SessionState.CountryId}"))</strong></span>
            </div>
            @if (_usersLoading)
            {
                <div class="users-status">Loading…</div>
            }
            else if (_usersError is not null)
            {
                <div class="users-status users-status--error">@_usersError</div>
            }
            else if (_users.Count == 0)
            {
                <div class="users-status">No users online.</div>
            }
            else
            {
                @foreach (var u in _users)
                {
                    <div class="user-row">
                        <span class="user-dot" style="background:@u.Colour;"></span>
                        <span class="user-name">@u.Name</span>
                    </div>
                }
            }
            </div>
        </div>
    }
    @if (_layerPanelOpen && _layerEntries.Count > 0)
    {
        <div class="layer-panel">
            <div class="layer-panel-title">
                <span style="flex:1">Layers</span>
                <button class="panel-close-btn" title="Close" @onclick="@(() => SetLayerPanelOpen(false))">&#10005;</button>
            </div>
            <div class="layer-panel-content">
            <input class="layer-search" type="search" placeholder="Search layers…"
                   @bind="_layerSearch" @bind:event="oninput" />
            @foreach (var cat in _layerEntries
                .Where(e => !e.IsBaseLayer && e.IsToggleable &&
                    (string.IsNullOrWhiteSpace(_layerSearch) ||
                     e.DisplayName.Contains(_layerSearch, StringComparison.OrdinalIgnoreCase) ||
                     e.Category.Contains(_layerSearch, StringComparison.OrdinalIgnoreCase) ||
                     e.Subcategory.Contains(_layerSearch, StringComparison.OrdinalIgnoreCase)))
                .GroupBy(e => e.Category)
                .OrderBy(g => g.Key))
            {
                <details class="layer-cat" open>
                    <summary class="layer-cat-header">@TitleCase(cat.Key)</summary>
                    @foreach (var sub in cat.GroupBy(e => e.Subcategory).OrderBy(g => g.Key))
                    {
                        <details class="layer-sub" open>
                            <summary class="layer-sub-header">@TitleCase(sub.Key)</summary>
                            @foreach (var entry in sub)
                            {
                                <label class="layer-panel-row">
                                    <input type="checkbox" checked="@entry.Visible"
                                           @onchange="@(async e => await ToggleLayerAsync(entry, (bool)e.Value!))" />
                                    <span class="layer-panel-name" title="@entry.Tooltip">@entry.DisplayName</span>
                                    @if (entry.MediaUrl is not null)
                                    {
                                        <a class="info-icon-link" href="@entry.MediaUrl" target="_blank" rel="noopener noreferrer" title="Open wiki page">ⓘ</a>
                                    }
                                </label>
                            }
                        </details>
                    }
                </details>
            }
            </div>
        </div>
    }

    @if (_legendPanelOpen && _legendOrder.Count > 0)
    {
        <div class="legend-panel">
            <div class="legend-panel-title">
                <span style="flex:1">Legend</span>
                <button class="panel-close-btn" title="Close" @onclick="@(() => SetLegendPanelOpen(false))">&#10005;</button>
            </div>
            <div class="legend-panel-content">
            @for (int i = _legendOrder.Count - 1; i >= 0; i--)
            {
                var entry = _legendOrder[i];
                var idx = i; // capture for lambdas
                <div class="legend-layer" draggable="true" data-legend-idx="@idx">
                    <div class="legend-layer-header">
                        <span class="legend-drag-handle" title="Drag to reorder">
                            <svg viewBox="0 0 8 12" width="10" height="14" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="2" cy="2" r="1"/>
                                <circle cx="6" cy="2" r="1"/>
                                <circle cx="2" cy="6" r="1"/>
                                <circle cx="6" cy="6" r="1"/>
                                <circle cx="2" cy="10" r="1"/>
                                <circle cx="6" cy="10" r="1"/>
                            </svg>
                        </span>
                        <span class="legend-name-group">
                            <span class="legend-layer-name" title="@entry.Tooltip">@entry.DisplayName</span>
                            @if (entry.MediaUrl is not null)
                            {
                                <a class="info-icon-link" href="@entry.MediaUrl" target="_blank" rel="noopener noreferrer" title="Open wiki page">ⓘ</a>
                            }
                        </span>
                        <button class="legend-hide-btn" title="Hide layer"
                                @onclick="@(async () => await ToggleLayerAsync(entry, false))">&#10005;</button>
                    </div>
                    @foreach (var td in entry.TypeDefs)
                    {
                        <div class="legend-row">
                            <span class="legend-swatch" style="background:@HexToCss(td.Color);"></span>
                            <span class="legend-label">@td.Label</span>
                            @if (td.MediaUrl is not null)
                            {
                                <a class="info-icon-link" href="@td.MediaUrl" target="_blank" rel="noopener noreferrer" title="Open wiki page">ⓘ</a>
                            }
                        </div>
                    }
                </div>
            }
            </div>
        </div>
    }
</div>

@if (_popupVisible)
{
    <div class="map-popup" style="left:@(_popupX)px;top:@(_popupY)px">
        <div class="map-popup-header">
            <span class="map-popup-title">@_popupLayerName</span>
            <button class="map-popup-close" @onclick="@(() => _popupVisible = false)">&#10005;</button>
        </div>
        <div class="map-popup-body">
            @if (_popupProps.Count == 0)
            {
                <div class="map-popup-empty">No properties available</div>
            }
            else
            {
                <table class="map-popup-table">
                    @foreach (var (label, value) in _popupProps)
                    {
                        <tr>
                            <th>@label</th>
                            <td>@value</td>
                        </tr>
                    }
                </table>
            }
        </div>
    </div>
}

@if (_isLoading || _loadingFading)
{
    var splashClass = "splash-overlay" + (_loadingFading ? " splash-overlay--out" : "");
    <div class="@splashClass">
        <div class="splash-vignette"></div>
        <div class="splash-content">
            <div class="splash-logo"><em>MSP</em> Challenge</div>
            <div class="splash-tagline">Marine Spatial Planning</div>
            <div class="splash-bar-wrap"><div class="splash-bar"></div></div>
            <div class="splash-status">@_loadingStatus</div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="map-error-overlay">
        @errorMessage
        @if (HostEnvironment.IsDevelopment() && !string.IsNullOrEmpty(errorDetail))
        {
            <pre class="map-error-detail">@errorDetail</pre>
        }
    </div>
}

@if (HostEnvironment.IsDevelopment())
{
    @if (_wsLogVisible)
    {
        <div class="ws-console">
            <div class="ws-console-header">
                <span class="ws-console-title">WebSocket Log</span>
                <span class="ws-console-count">@_wsLog.Count msg@(_wsLog.Count == 1 ? "" : "s")</span>
                <button class="ws-console-clear" @onclick="@(() => { lock(_wsLog) _wsLog.Clear(); _wsSelectedRaw = null; })">Clear</button>
                <button class="ws-console-clear" @onclick="@(() => _wsLogVisible = false)" title="Hide">&#10005;</button>
            </div>
            @if (_wsSelectedRaw is not null)
            {
                <div class="ws-detail-pane">
                    <div class="ws-detail-header">
                        <span class="ws-detail-label">Full message</span>
                        <button class="ws-console-clear" @onclick="@(() => _wsSelectedRaw = null)">&#10005;</button>
                    </div>
                    <pre class="ws-detail-body">@PrettyPrintJson(_wsSelectedRaw)</pre>
                </div>
            }
            <div class="ws-console-body">
                @foreach (var entry in _wsLog)
                {
                    var isSelected = entry.Raw == _wsSelectedRaw;
                    <div class="ws-log-row @(isSelected ? "ws-log-row--selected" : "")"
                         @onclick="@(() => _wsSelectedRaw = isSelected ? null : entry.Raw)">
                        <span class="ws-log-time">@entry.ReceivedAt.ToString("HH:mm:ss.fff")</span>
                        <span class="ws-log-header">@entry.HeaderName</span>
                        <span class="ws-log-raw">@entry.Raw</span>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <button class="ws-console-show-btn" @onclick="@(() => _wsLogVisible = true)" title="Show WebSocket Log">WS</button>
    }
}

