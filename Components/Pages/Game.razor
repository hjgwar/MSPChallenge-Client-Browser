@page "/game"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using MSPChallenge_Client_Browser.Components.Pages.GameComponents

<PageTitle>MSP Challenge</PageTitle>

@if (_isLoading || _loadingFading)
{
    <GameLoading IsFading="@_loadingFading" LoadingStatus="@_loadingStatus" />
}

<MapViewPort @ref="Map" />

<SideBarPanelControl @ref="SideBarPanelController" />

<div class="map-sidebar-panels">
    @if (GameSessionState.OnlineUsersPanelOpen)
    {
        <OnlineUsers OnCloseThisPanel="SideBarPanelController.ToggleOnlineUsersPanel" />
    }
    @if (Map is not null && GameSessionState.LayerPanelOpen && GameSessionState.LayerEntries.Count > 0)
    {
        <LayerSelector ToggleLayerAsync="Map.ToggleLayerAsync" OnCloseThisPanel="SideBarPanelController.ToggleLayerPanel" />
    }

    @if (Map is not null && GameSessionState.LegendPanelOpen && GameSessionState.LegendOrderLayerIds.Count > 0)
    {
        <MapLegend ToggleLayerAsync="Map.ToggleLayerAsync" SyncZIndicesAsync="Map.SyncZIndicesAsync" OnCloseThisPanel="SideBarPanelController.ToggleLegendPanel" />
    }
</div>

<div class="map-right-panels">
    <GameTimeView @ref="GameTimeViewer" MapJSModule="Map?.MapJSModule"/>
    <div class="map-plan-panels">
        @* Plan detail panel — shown when a plan is selected or in edit mode for new plan *@
        @if (Map is not null && (GameSessionState.SelectedPlanId.HasValue || GameSessionState.EditMode))
        {
            <PlanDetails @ref="PlanDetailsPanel" Map="@Map" />
        }

        @* Create plan panel — shown instead of plan-detail when creating a new plan *@
        @if (GameSessionState.CreatePlanOpen)
        {
            <PlanCreation @ref="PlanCreationPanel" OpenEditMode="@OpenEditModeFromCreation" />
        }

    </div>
</div>

@if (GameSessionState.PlansPanelOpen)
{
    <PlansList />
}

<MapProperties IsVisible="_popupVisible" 
               X="_popupX" 
               Y="_popupY" 
               LayerName="_popupLayerName" 
               Properties="_popupProps" 
               OnClose="ClosePopup" />

@if (GameTimeViewer is not null && GameTimeViewer.TimeManagerVisible) {
    <TimeManager OnCloseThisPanel="GameTimeViewer.ToggleTimeManager" />
}

@if (HostEnvironment.IsDevelopment())
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="map-error-overlay">
            @errorMessage
            @if (!string.IsNullOrEmpty(errorDetail))
            {
                <pre class="map-error-detail">@errorDetail</pre>
            }
        </div>
    }
    @if (_wsLogVisible)
    {
        <WebSocketLog LogEntries="_wsLog" OnClose="CloseWsLog" OnClear="ClearWsLog" />
    }
    else
    {
        <button class="ws-console-show-btn" @onclick="@(() => _wsLogVisible = true)" title="Show WebSocket Log">WS</button>
    }
}