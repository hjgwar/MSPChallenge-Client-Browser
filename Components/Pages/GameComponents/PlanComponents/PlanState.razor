@inherits GameComponentBase
@using MSPChallenge_Client_Browser.Components.Pages.GameComponents.PlanComponents.PlanPanelComponents
@using MSPChallenge_Client_Browser.Utils.PlanCalculations
<div class="plan-detail-state-row">
    @if (_planStateOpen)
    {
        <PlanPanelState SelectedPlanIssues="SelectedPlanIssues" 
                        SelectedPlanApprovalRequired="SelectedPlanApprovalRequired"
                        PlanStatePending="_planStatePending" 
                        PlanStateSending="_planStateSending"
                        PlanStatePendingChanged="OnPlanStatePendingChanged"
                        SetPlanStateAsync="SetPlanStateAsync" 
                        OnCloseThisPanel="TogglePlanStatePanel"/>
    }
    @if (CanChangeState())
    {
        <button class="plan-detail-action-row" type="button" @onclick="TogglePlanStatePanel">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon">
                <path d="M2 4h12v8a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V4z"/>
                <path d="M2 4l6-2 6 2"/>
            </svg>
            <span>Plan state: @PlanStates.PlanStateLabel(Plan?.State)</span>
        </button>
    }
    else
    {
        <div class="plan-detail-info-row">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon">
                <path d="M2 4h12v8a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V4z"/>
                <path d="M2 4l6-2 6 2"/>
            </svg>
            <span>Plan state: @PlanStates.PlanStateLabel(Plan?.State)</span>
        </div>
    }
</div>