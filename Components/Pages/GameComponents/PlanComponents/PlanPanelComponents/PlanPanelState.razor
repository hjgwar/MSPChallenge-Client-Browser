@using MSPChallenge_Client_Browser.Utils.PlanCalculations
@inherits GameComponentBase
<div class="panel plan-message-panel plan-state-panel">
    <div class="panel-title plan-message-panel-header">
        <span style="flex: 1">Plan State</span>
        <button class="panel-close-btn" type="button" title="Close" @onclick="OnCloseThisPanel">&#10005;</button>
    </div>
    <div class="panel-content plan-message-panel-body plan-state-panel-body">
        <div class="plan-state-dropdown @(_planStateDropdownOpen ? "open" : "")">
            <button class="plan-state-dropdown-trigger" type="button"
                    disabled="@PlanStateSending"
                    @onclick:stopPropagation="true"
                    @onclick="@(() => _planStateDropdownOpen = !_planStateDropdownOpen)">
                <span>@PlanStates.PlanStateLabel(PlanStatePending!)</span>
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg" class="plan-state-dropdown-arrow">
                    <polyline points="4,6 8,10 12,6"/>
                </svg>
            </button>
            @if (_planStateDropdownOpen)
            {
                <div class="plan-state-dropdown-list">
                    @foreach (Models.PlanState availableState in GetAvailablePlanStates(GameSessionService.SelectedPlan))
                    {
                        <button class="plan-state-dropdown-item @(availableState == PlanStatePending ? "selected" : "")"
                                type="button"
                                @onclick:stopPropagation="true"
                                @onclick="@(async () => { await PlanStatePendingChanged.InvokeAsync(availableState); _planStateDropdownOpen = false; })">
                            @PlanStates.PlanStateLabel(availableState)
                        </button>
                    }
                </div>
            }
        </div>
    </div>
    <div class="plan-edit-footer">
        <button class="plan-edit-footer-btn plan-edit-footer-btn--cancel" type="button"
                disabled="@PlanStateSending"
                @onclick="OnCloseThisPanel">
            &#8249; Cancel
        </button>
        <button class="plan-edit-footer-btn plan-edit-footer-btn--accept" type="button"
                disabled="@PlanStateSending"
                @onclick="SetPlanStateAsync">
            Accept &#8250;
        </button>
    </div>
</div>