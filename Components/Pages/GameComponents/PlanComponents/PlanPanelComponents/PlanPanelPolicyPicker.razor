@inherits GameComponentBase
<div class="panel plan-message-panel plan-policy-panel">
    <div class="panel-title plan-message-panel-header">
        <span style="flex: 1">Policy Picker</span>
        <button class="panel-close-btn" type="button" title="Close" @onclick="TogglePolicyPicker">&#x2715;</button>
    </div>
    <div class="panel-content plan-message-panel-body plan-policy-picker-body">
        @foreach (PolicySetting policy in GameSessionService.AvailablePolicies)
        {
            var isSelected = _editPolicyTypes.Contains(policy.PolicyType);
            <div class="plan-policy-item @(!policy.Enabled ? "plan-policy-item--disabled" : "")"
                    @onclick="@(policy.Enabled ? async () => await TogglePolicyType(policy.PolicyType) : (Func<Task>)(() => Task.CompletedTask))" >
                <input type="checkbox" class="plan-policy-toggle" checked="@isSelected" disabled="@(!policy.Enabled)" tabindex="-1" />
                <span class="plan-policy-name">@policy.DisplayName</span>
            </div>
        }
    </div>
</div>