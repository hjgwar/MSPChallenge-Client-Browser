@inherits GameComponentBase
@using MSPChallenge_Client_Browser.Components.Pages.GameComponents.PlanComponents.PlanPanelComponents
    @{
        IEnumerable<string>? _displayedPolicies = _editMode
            ? (IEnumerable<string>)GameSessionService.AvailablePolicies
                    .Where(ap => _editPolicyTypes.Contains(ap.PolicyType))
                    .Select(ap => ap.DisplayName)
                    .ToList()
            : _detailPlan.PolicyNames;
    }
    @if (_displayedPolicies is not null) {
        @if (_displayedPolicies.Count() == 0)
        {
            <div class="plan-detail-info-row">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon" opacity="0.5">
                    <path d="M8 1l1.5 3.5H13l-2.8 2 1 3.5L8 8l-3.2 2 1-3.5L3 5h3.5L8 1z"/>
                </svg>
                <span>No policies</span>
            </div>
        }
        @foreach (var pname in _displayedPolicies)
        {
            <div class="plan-detail-item-row">
                <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="plan-detail-icon">
                    <path d="M8 1l1.5 3.5H13l-2.8 2 1 3.5L8 8l-3.2 2 1-3.5L3 5h3.5L8 1z"/>
                </svg>
                <span>@pname</span>
            </div>
        }
    }
    @if (_editMode)
    {
        <div class="plan-detail-policy-row">
            @if (_policyPickerOpen)
            {
                <PlanPanelPolicyPicker SelectedPolicyTypes="@_editPolicyTypes" 
                                       OnTogglePolicyType="@OnTogglePolicyType" 
                                       OnClose="@TogglePolicyPicker" />
            }
            <button class="plan-edit-add-btn" type="button" disabled="@EditSaving" @onclick="TogglePolicyPicker">
                Add or remove policies
            </button>
        </div>
    }
