<Toasts class="p-3" Messages="messages" Placement="ToastsPlacement.MiddleCenter" />
<nav class="map-sidebar">
    <button class="sidebar-btn" title="Home"
            @onclick="GameUIStateService.ToggleOptionsPanel">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
            <defs>
                <!-- 1. Define a single rounded tooth at 22.5 degrees -->
                <rect id="tooth" x="43" y="4" width="14" height="16" rx="3" transform="rotate(22.5 50 50)" />
                
                <!-- 2. Cut out the center hole cleanly -->
                <mask id="hole">
                <rect width="100" height="100" fill="white" />
                <circle cx="50" cy="50" r="18" fill="black" />
                </mask>
            </defs>

            <!-- 3. Combine body + 8 rotated teeth and apply the center hole mask -->
            <g fill="#f5f5f5" mask="url(#hole)">
                <circle cx="50" cy="50" r="34" />
                
                <use href="#tooth" />
                <use href="#tooth" transform="rotate(45 50 50)" />
                <use href="#tooth" transform="rotate(90 50 50)" />
                <use href="#tooth" transform="rotate(135 50 50)" />
                <use href="#tooth" transform="rotate(180 50 50)" />
                <use href="#tooth" transform="rotate(225 50 50)" />
                <use href="#tooth" transform="rotate(270 50 50)" />
                <use href="#tooth" transform="rotate(315 50 50)" />
            </g>
        </svg>
    </button>
    <div class="sidebar-separator"></div>
    <button class="sidebar-btn" style="@CountryBtnStyle()"
            title="Online users"
            @onclick="GameUIStateService.ToggleOnlineUsersPanel">
        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <circle cx="5.5" cy="4.5" r="2.5"/>
            <path d="M0.5 13.5c0-2.76 2.24-5 5-5s5 2.24 5 5"/>
            <circle cx="11.5" cy="4.5" r="2" opacity="0.55"/>
            <path d="M10.5 13.5a5 5 0 0 1 1-3.06A4.5 4.5 0 0 1 15.5 13.5" opacity="0.55"/>
        </svg>
    </button>
    <div class="sidebar-separator"></div>
    <button class="sidebar-btn @(GameUIStateService.PlansPanelOpen ? "sidebar-btn--active" : "")" title="Plans"
            @onclick="GameUIStateService.TogglePlansPanel">
        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 2h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.3"/>
            <line x1="4.5" y1="5.5" x2="11.5" y2="5.5" stroke="currentColor" stroke-width="1.2"/>
            <line x1="4.5" y1="8"   x2="11.5" y2="8"   stroke="currentColor" stroke-width="1.2"/>
            <line x1="4.5" y1="10.5" x2="9"   y2="10.5" stroke="currentColor" stroke-width="1.2"/>
        </svg>
    </button>
    <button class="sidebar-btn @(GameUIStateService.CreatePlanOpen ? "sidebar-btn--active" : "")" title="New plan"
            @onclick="GameUIStateService.ToggleCreatePlanPanel">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="12" height="12" rx="1" stroke-width="1.3"/>
            <line x1="8" y1="5" x2="8" y2="11"/>
            <line x1="5" y1="8" x2="11" y2="8"/>
        </svg>
    </button>
    <div class="sidebar-separator"></div>
    <button id="dependencies-button" class="sidebar-btn" title="Dependencies"
            @onclick="OpenDependenciesPage">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" xmlns="http://www.w3.org/2000/svg">
            <circle cx="8" cy="8" r="6"/>
            <path d="M8 2 Q8 8 14 8"  stroke-width="1.0" opacity="0.85"/>
            <path d="M8 2 Q8 8 4 13"  stroke-width="1.0" opacity="0.85"/>
            <path d="M14 8 Q8 8 4 13" stroke-width="1.0" opacity="0.85"/>
        </svg>
    </button>
    <button class="sidebar-btn" title="KPI Dashboard"
            @onclick="OpenKpiDashboardPage">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="9" width="2.6" height="5" fill="currentColor" stroke="none"/>
            <rect x="6.7" y="6" width="2.6" height="8" fill="currentColor" stroke="none"/>
            <rect x="11.4" y="2.5" width="2.6" height="11.5" fill="currentColor" stroke="none"/>
        </svg>
    </button>
    <div class="sidebar-separator"></div>
    <button id="layers-button" class="sidebar-btn @(GameUIStateService.LayerPanelOpen ? "sidebar-btn--active" : "")"
            title="Layers"
            @onclick="GameUIStateService.ToggleLayerPanel">
        <svg viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 1l7 3.5-7 3.5L1 4.5 8 1z"/>
            <path d="M1 8.5l7 3.5 7-3.5"/>
            <path d="M1 12l7 3.5L15 12"/>
        </svg>
    </button>
    <button id="legend-button" class="sidebar-btn @(GameUIStateService.LegendPanelOpen ? "sidebar-btn--active" : "")" title="Legend"
            @onclick="GameUIStateService.ToggleLegendPanel">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="3" width="4" height="4" rx="0.5" fill="currentColor" stroke="none" opacity="0.7"/>
            <line x1="8" y1="5" x2="14" y2="5"/>
            <rect x="2" y="9" width="4" height="4" rx="0.5" fill="currentColor" stroke="none" opacity="0.7"/>
            <line x1="8" y1="11" x2="14" y2="11"/>
        </svg>
    </button>
</nav>