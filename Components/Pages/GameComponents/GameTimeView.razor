@inherits GameComponentBase
<div class="game-bar">
    <div class="game-bar-row">
        <div class="game-bar-clock">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                    xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12,6 12,12 16,14"/>
            </svg>
        </div>
        <div class="game-bar-body">
            <div class="game-bar-date">@GameSessionState.MonthToDate(GameSessionState.GameCurrentMonth)</div>
            <div class="game-bar-timeline">
                <span class="game-bar-year">@GameSessionState.GameStartYear</span>
                <div class="game-bar-track">
                    <div class="game-bar-fill" style="width:@(BarProgress.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    <div class="game-bar-needle" style="left:@(BarProgress.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    @if (GameSessionState.SelectedPlanId != 0 && _planForNeedle is not null)
                    {
                        <div class="game-bar-plan-needle" style="left:@(BarNeedle())%"
                            title="Plan time: @GameSessionState.MonthToDate(_planForNeedle.StartDate)"></div>
                    }
                </div>
                <span class="game-bar-year">@GameSessionState.GameEndYear</span>
            </div>
        </div>
        @if (UserSessionService.IsAdmin)
        {
            <div class="game-bar-state game-bar-state--clickable" @onclick="ToggleTimeManager">
                <div class="game-bar-state-label">@GameSessionState.GameStateLabel(GameSessionState.GameState)</div>
                <div class="game-bar-timeleft">@GameSessionState.FormatTimeLeft(GameSessionState.EraTimeLeft)</div>
            </div>
        }
        else
        {
            <div class="game-bar-state">
                <div class="game-bar-state-label">@GameSessionState.GameStateLabel(GameSessionState.GameState)</div>
                <div class="game-bar-timeleft">@GameSessionState.FormatTimeLeft(GameSessionState.EraTimeLeft)</div>
            </div>
        }
    </div>
    @if (GameSessionState.SelectedPlanId != 0 && _planForNeedle is not null)
    {
        <div class="game-bar-plan-view">
            <div class="game-bar-plan-time">
                <svg class="game-bar-plan-eye" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" xmlns="http://www.w3.org/2000/svg">
                    <ellipse cx="10" cy="10" rx="8" ry="5"/>
                    <circle cx="10" cy="10" r="2.5" fill="currentColor" stroke="none"/>
                </svg>
                <span class="game-bar-plan-time-label">Viewing plan</span>
                <span class="game-bar-plan-time-date">@GameSessionState.MonthToDate(_planForNeedle.StartDate)</span>
            </div>
            <div class="game-bar-plan-modes">
                <button class="plan-mode-btn @(GameSessionState.PlanViewMode == PlanViewMode.Original ? "plan-mode-btn--active" : "")"
                        title="Show original data only"
                        @onclick="@(async () => await SetPlanViewModeAsync(PlanViewMode.Original))">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 2h8l4 4v12H4V2z"/>
                        <path d="M12 2v4h4"/>
                        <line x1="7" y1="9"  x2="13" y2="9"  stroke-width="1.1"/>
                        <line x1="7" y1="12" x2="13" y2="12" stroke-width="1.1"/>
                        <line x1="7" y1="15" x2="11" y2="15" stroke-width="1.1"/>
                    </svg>
                    <span>Original</span>
                </button>
                <button class="plan-mode-btn @(GameSessionState.PlanViewMode == PlanViewMode.AfterChanges ? "plan-mode-btn--active" : "")"
                        title="Show base data with plan changes applied"
                        @onclick="@(async () => await SetPlanViewModeAsync(PlanViewMode.AfterChanges))">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 2h8l4 4v12H4V2z" opacity="0.65"/>
                        <path d="M12 2v4h4" opacity="0.65"/>
                        <line x1="7" y1="9"  x2="11" y2="9"  stroke-width="1.1" opacity="0.65"/>
                        <line x1="7" y1="12" x2="11" y2="12" stroke-width="1.1" opacity="0.65"/>
                        <path d="M12 2L16 6H12V2z" fill="currentColor" fill-opacity="0.75" stroke="currentColor" stroke-width="1.3"/>
                    </svg>
                    <span>After changes</span>
                </button>
                <button class="plan-mode-btn @(GameSessionState.PlanViewMode == PlanViewMode.ChangesOnly ? "plan-mode-btn--active" : "")"
                        title="Show plan changes only, without base data"
                        @onclick="@(async () => await SetPlanViewModeAsync(PlanViewMode.ChangesOnly))">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 2h8l4 4v12H4V2z" opacity="0.22" stroke-dasharray="3,2"/>
                        <path d="M12 2v4h4" opacity="0.22"/>
                        <path d="M12 2L16 6H12V2z" fill="currentColor" fill-opacity="0.75" stroke="currentColor" stroke-width="1.4"/>
                    </svg>
                    <span>Changes only</span>
                </button>
            </div>
        </div>
    }
</div>