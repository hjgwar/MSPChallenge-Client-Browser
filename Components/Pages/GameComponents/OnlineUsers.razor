@inherits GameComponentBase
<div class="panel users-panel">
    <div class="panel-title users-panel-header">
        Online Users <button class="panel-close-btn" title="Close" @onclick="OnCloseThisPanel">&#10005;</button>
    </div>
    <div class="panel-content users-panel-content">
        <div class="users-my-country">
            <span class="user-dot" style="background:@UserSessionService.User.Country.Color;"></span>
            <span>Your country: <strong>@UserSessionService.User.Country.Name</strong></span>
        </div>
    @if (_usersLoading)
    {
        <div class="users-status">Loading…</div>
    }
    else if (_usersError is not null)
    {
        <div class="users-status users-status--error">@_usersError</div>
    }
    else if (_users.Count == 0)
    {
        <div class="users-status">No users online.</div>
    }
    else
    {
        @foreach (User u in _users)
        {
            <div class="user-row">
                <span class="user-dot" style="background:@u.Country.Color;"></span>
                <span class="user-name">@u.Name</span>
            </div>
        }
    }
    </div>
</div>