@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject MSPChallenge_Client_Browser.Services.SessionState SessionState
@inject MSPChallenge_Client_Browser.Services.MspApiClient ApiClient

<PageTitle>MSP Challenge</PageTitle>

<h1>Join an MSP Challenge Session</h1>

<div class="mb-3">
    <label for="serverAddress" class="form-label">Server Address</label>
    <div class="input-group">
        <input id="serverAddress" class="form-control" type="text"
               @bind="serverAddress" @bind:event="oninput"
               @onkeydown="@(async (e) => { if (e.Key == "Enter") await FetchGameListAsync(); })"
               placeholder="server.mspchallenge.info" />
        <button class="btn btn-primary" @onclick="FetchGameListAsync" disabled="@isLoading">
            @(isLoading ? "Loading..." : "Confirm")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(serverDescription))
{
    <div class="alert alert-info">@serverDescription</div>
}

@if (sessions is not null)
{
    @if (sessions.Count == 0)
    {
        <p>No sessions are available on this server.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Edition</th>
                    <th>State</th>
                    <th>Players Active</th>
                    <th>Current Month</th>
                    <th>End Month</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in sessions)
                {
                    <tr>
                        <td>@GetString(session, "name")</td>
                        <td>@GetString(session, "edition_name")</td>
                        <td>@GetString(session, "game_state")</td>
                        <td>@GetString(session, "players_active")</td>
                        <td>@GetString(session, "current_month_formatted")</td>
                        <td>@GetString(session, "end_month_formatted")</td>
                        <td><button class="btn btn-success btn-sm" @onclick="() => ConnectToSession(session)">Connect</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

